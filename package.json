{
  "name": "share-workspace",
  "private": true,
  "version": "0.58.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server.js",
    "start": "node server.js",
    "build": "vite build",
    "check:bundle": "node src/security/build/checkBundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test --test-isolation=none test/*.test.js src/chatbot/chatStream.test.js shared/quiz.test.js src/security/server/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.66.0",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
