# Server-only variables. Add your key locally; never prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=3001
# Required only for server-side administrator account management. Never use a
# VITE_ prefix or expose this value to browser code.
SUPABASE_SECRET_KEY=

# Public browser configuration. Empty uses Vite's local proxy / same-origin API.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional static-asset CDN base (must end with /). Supabase Storage already
# serves uploaded resources through its global CDN.
VITE_ASSET_BASE_URL=

# Required on public deployments. Use exact frontend origin(s), without paths.
APP_ORIGINS=
# Set to production on your host. Production serves the built dist/ directory.
NODE_ENV=development
# Persist these directories on one server instance; do not point them at source/dist.
DATA_DIR=
UPLOADS_DIR=
# Explicit proxy hops; leave 0 unless a trusted reverse proxy sits in front.
TRUST_PROXY_HOPS=0
# Exact allowed password-recovery URL configured in your Supabase dashboard.
AUTH_REDIRECT_URL=

# Optional distributed cache. Leave empty locally to use the bounded process
# cache; set both values in production to share cached data across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
